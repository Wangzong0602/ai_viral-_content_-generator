# ============================================================
# AI 爆文智能创作平台 - 环境变量配置文件
# 复制一份为 .env 后按需修改（本文件已被 .gitignore 忽略，不会提交到 git）
# 注意：.env 里中文注释或值需保持 UTF-8 编码
# ============================================================

# ---------- 数据库连接 ----------
# 格式：mysql+pymysql://用户名:密码@主机:端口/库名?charset=utf8mb4
# charset=utf8mb4 必须保留，否则中文会乱码
DATABASE_URL=mysql+pymysql://root:010819@127.0.0.1:3306/ai_content_generator?charset=utf8mb4

# ---------- Redis 连接 ----------
# 本机 6379 端口被系统保留无法绑定，Redis 运行在 16379 端口（见 start_dev.bat）
REDIS_URL=redis://127.0.0.1:16379/0

# ---------- JWT 令牌 ----------
# JWT_SECRET_KEY 是签名密钥：生产环境必须换成随机长字符串（越复杂越安全）！
JWT_SECRET_KEY=ai-viral-content-generator-secret-key-change-me
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ---------- 调试模式 ----------
# true：控制台会打印 SQL 日志（开发用）；生产环境改为 false
DEBUG=true
